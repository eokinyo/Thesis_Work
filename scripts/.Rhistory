solver = "solnp",
fit.control = list(eval.se = TRUE)
)
cat("GARCH-X and IGARCH-X models fitted successfully.\n")
# =====================================================
# Estimate sentiment-augmented GARCH models
# =====================================================
# Solver: "solnp"
# Standard errors computed automatically
# -------------------------------
# 1. GARCH-X(1,1)
# -------------------------------
fit_garchx_norm <- rugarch::ugarchfit(
spec   = spec_garchx_norm,
data   = r,
solver = "solnp"
)
fit_garchx_std <- rugarch::ugarchfit(
spec   = spec_garchx_std,
