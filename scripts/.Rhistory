res_garchx_norm  <- extract_results(fit_garchx_norm,  "GARCHX_Normal")
res_garchx_std   <- extract_results(fit_garchx_std,   "GARCHX_Student_t")
res_igarchx_norm <- extract_results(fit_igarchx_norm, "IGARCHX_Normal")
res_igarchx_std  <- extract_results(fit_igarchx_std,  "IGARCHX_Student_t")
